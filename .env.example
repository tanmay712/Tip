# ─── Discord ───────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=           # OAuth2 client secret; callback uses identify scope only
DISCORD_GUILD_ID=                # Optional: restrict command registration to one guild (dev mode)
APP_BASE_URL=                    # Public origin, e.g. https://crypto.example.com (no trailing slash)
OWNER_DISCORD_IDS=               # Comma-separated Discord IDs for owner-only commands
TERMS_VERSION=2026-11
LEGAL_DOCUMENTS_APPROVED=false  # Set true only after replacing/reviewing the policy and terms templates

# ─── Public RPC endpoints (no account sign-in required) ─────
# Defaults use public RPCs; override individual endpoints if a public service is rate-limited.
ETHEREUM_RPC_URL=                # Mainnet default: PublicNode
ETHEREUM_TESTNET_RPC_URL=        # Sepolia default: PublicNode
POLYGON_RPC_URL=                 # Mainnet default: PublicNode
POLYGON_TESTNET_RPC_URL=         # Amoy default: PublicNode
ARBITRUM_RPC_URL=                # Mainnet default: PublicNode
ARBITRUM_TESTNET_RPC_URL=        # Sepolia default: PublicNode
OPTIMISM_RPC_URL=                # Mainnet default: PublicNode
OPTIMISM_TESTNET_RPC_URL=        # Sepolia default: PublicNode
BASE_RPC_URL=                    # Mainnet default: PublicNode
BASE_TESTNET_RPC_URL=            # Sepolia default: PublicNode
ZKSYNC_RPC_URL=                  # Mainnet default: zkSync public RPC
ZKSYNC_TESTNET_RPC_URL=          # Sepolia default: zkSync public RPC
AVALANCHE_RPC_URL=               # Mainnet default: Avalanche public RPC
AVALANCHE_TESTNET_RPC_URL=       # Fuji default: Avalanche public RPC
SOLANA_RPC_URL=                  # Mainnet default: Solana public RPC
SOLANA_TESTNET_RPC_URL=          # Devnet default: Solana public RPC
EVM_CONFIRMATIONS=6
EVM_BLOCK_SCAN_BATCH_SIZE=100

# ─── Litecoin (hosted BlockCypher-compatible UTXO API) ───────
LITECOIN_API_BASE_URL=https://api.blockcypher.com/v1/ltc  # HTTPS provider-compatible API base
LITECOIN_API_TOKEN=              # Required to enable Litecoin deposit/withdraw provider access
LITECOIN_CONFIRMATIONS=6         # Confirmations required before a deposit is credited
LITECOIN_MAX_WITHDRAWAL_FEE_SATOSHIS=1000000  # 0.01 LTC maximum network fee charged per withdrawal

# ─── Security ──────────────────────────────────────────
ENCRYPTION_SECRET=               # 32-byte hex string for AES-256-GCM wallet encryption

# ─── Database ──────────────────────────────────────────
DATABASE_URL=file:/app/data/hodlr.db  # SQLite in Docker; use file:./hodlr.db locally

# ─── API Server ────────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0

# ─── Defaults ──────────────────────────────────────────
DEFAULT_NETWORK=mainnet          # mainnet or testnet
